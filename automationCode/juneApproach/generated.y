/* --- Helper Rules for Flexible Token Handling --- */
/* Accept STRING_LIST or NUM values */
string_value: STRING_LIST | NUM;

/* Optional SPACE before value */
metadata_value: string_value | SPACE string_value;


/* --- WriteHeader() --- */
